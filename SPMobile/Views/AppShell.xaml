<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SPMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SPMobile.Views"
    Title="StudentPortalMobile" 
    FlyoutItemIsVisible="False"
  
     Shell.TabBarBackgroundColor="#008080"
     Shell.TabBarForegroundColor="White"
     Shell.TabBarUnselectedColor="#f7ede2"
     Shell.TabBarTitleColor="#fefee3">

    <ShellContent
   Title="Login"
   ContentTemplate="{DataTemplate local:MainPage}"
   Route="LoginPage"
   FlyoutItemIsVisible="False" />

    <TabBar x:Name="MainTabBar">
        <Tab Title="Dashboard" Icon="home.png">
            <ShellContent Route="DashBoardPage" ContentTemplate="{DataTemplate local:DashBoardPage}" />
        </Tab>

        <Tab x:Name="NotificationTab" Title="Notification" Icon="notification.png">
            <ShellContent ContentTemplate="{DataTemplate local:NotificationsPage}" />
        </Tab>

        <Tab Title="Logout" Icon="logout.png" Route="MainPage" Shell.TabBarIsVisible="False" FlyoutItemIsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
    </TabBar>

</Shell>
