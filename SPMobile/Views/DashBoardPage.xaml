<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:SPMobile.Models"
             x:Class="SPMobile.Views.DashBoardPage"
             Title="Attendance"
             BackgroundColor="#F5F5F5"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>

        <!-- MAIN CONTENT -->
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- HEADER CARD -->
                <Border BackgroundColor="#008080" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="15"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.25" Offset="2,2" Radius="10"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="5">
                        <HorizontalStackLayout Spacing="10">
                            <Image Source="logo.png"
                                   HeightRequest="30"
                                   WidthRequest="30"
                                   VerticalOptions="Center"/>

                            <Label Text="Greenhills College Tech."
                                   TextColor="White"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label x:Name="lblStudentName"
                               TextColor="White"
                               FontSize="16"
                               Opacity="0.9"
                               Margin="40,0,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Your Courses"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#333333"
                       Margin="5,10,0,0"/>

                <!-- COURSE LIST -->
                <CollectionView x:Name="cvCourses" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,2"
                                    Padding="20"
                                    BackgroundColor="White"
                                    Stroke="#E0E0E0"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>

                                <Border.Shadow>
                                    <Shadow Brush="Black" Opacity="0.15" Offset="1,1" Radius="6"/>
                                </Border.Shadow>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCourseTapped"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding CourseName}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#008080"/>
                                        <Label Text="View Attendance Details"
                                               FontSize="12"
                                               TextColor="#777777"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="›"
                                           FontSize="24"
                                           VerticalOptions="Center"
                                           Opacity="0.5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- DARK OVERLAY -->
        <BoxView x:Name="ModalBackground"
                 BackgroundColor="Black"
                 Opacity="0.6"
                 IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="CloseModal"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- MODAL -->
        <Border x:Name="AttendanceModal"
                IsVisible="False"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                WidthRequest="340"
                HeightRequest="550"
                BackgroundColor="White"
                Padding="0">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.3" Offset="2,2" Radius="12"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto, Auto, *, Auto">

                <!-- HEADER -->
                <BoxView Color="#008080" HeightRequest="60" Grid.Row="0"/>

                <Label x:Name="lblModalTitle"
                       TextColor="White"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Margin="0,15"
                       Grid.Row="0"/>

                <!-- STATS -->
                <Border Grid.Row="1"
                        Margin="15,10"
                        Padding="15"
                        BackgroundColor="#F0F9F9"
                        Stroke="#008080"
                        StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="20">

                        <!-- PRESENT -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Image Source="present.png" HeightRequest="20"/>
                            <Label x:Name="lblPresentCount"
                                   Text="0"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#28A745"/>
                            <Label Text="Present" FontSize="10" TextColor="#555555"/>
                        </VerticalStackLayout>

                        <BoxView WidthRequest="1" BackgroundColor="#CCCCCC"/>

                        <!-- LATE -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Image Source="late.png" HeightRequest="20"/>
                            <Label x:Name="lblLateCount"
                                   Text="0"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="Orange"/>
                            <Label Text="Late" FontSize="10" TextColor="#555555"/>
                        </VerticalStackLayout>

                        <BoxView WidthRequest="1" BackgroundColor="#CCCCCC"/>

                        <!-- ABSENT -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Image Source="absent.png" HeightRequest="20"/>
                            <Label x:Name="lblAbsentCount"
                                   Text="0"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#DC3545"/>
                            <Label Text="Absent" FontSize="10" TextColor="#555555"/>
                        </VerticalStackLayout>

                        <BoxView WidthRequest="1" BackgroundColor="#CCCCCC"/>

                        <!-- PERCENT -->
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Image Source="percentage.png" HeightRequest="20"/>
                            <Label x:Name="lblPercentage"
                                   Text="0%"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#008080"/>
                            <Label Text="Rating" FontSize="10" TextColor="#555555"/>
                        </VerticalStackLayout>

                    </HorizontalStackLayout>
                </Border>

                <!-- ATTENDANCE LIST -->
                <CollectionView x:Name="cvModalAttendance" Grid.Row="2" Margin="15,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,5"
                                    Padding="15"
                                    Stroke="#F0F0F0"
                                    StrokeThickness="1">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>

                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Date}"
                                               FontAttributes="Bold"
                                               FontSize="14"
                                               TextColor="#333333"/>
                                        <Label Text="Prelim Period"
                                               FontSize="11"
                                               TextColor="Gray"/>
                                    </VerticalStackLayout>

                                    <!-- STATUS BADGE -->
                                    <Border Grid.Column="1"
                                            Padding="8,4"
                                            BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}, ConverterParameter=Background}">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="5"/>
                                        </Border.StrokeShape>

                                        <Label Text="{Binding Status}"
                                               FontAttributes="Bold"
                                               FontSize="11"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- CLOSE BUTTON -->
                <Button Grid.Row="3"
                        Text="CLOSE"
                        Clicked="CloseModal"
                        BackgroundColor="#008080"
                        TextColor="White"
                        FontAttributes="Bold"
                        Margin="20"
                        CornerRadius="10"/>

            </Grid>
        </Border>

    </Grid>
</ContentPage>