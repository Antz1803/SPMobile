<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SPMobile.Views.MainPage"        
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">

    <Grid RowDefinitions="80, *, 200">

        <!-- Header -->
        <Grid Grid.Row="0"
          BackgroundColor="#007B83"
          Padding="16"
          ColumnDefinitions="Auto,*"
          VerticalOptions="Center">

            <!-- Logo -->
            <Image Source="logo.png"
               HeightRequest="40"
               WidthRequest="40"
               VerticalOptions="Center"
               HorizontalOptions="Start"
               Aspect="AspectFit"/>

            <!-- Title -->
            <Label Grid.Column="1"
               Text="Greenhills College Tech."
               TextColor="White"
               FontSize="20"
               FontAttributes="Bold"
               VerticalOptions="Center"
               HorizontalOptions="Start"
               Margin="12,0,0,0"
               LineBreakMode="TailTruncation"/>
        </Grid>

        <ScrollView Grid.Row="1" VerticalOptions="Center">
            <VerticalStackLayout Padding="40,20" Spacing="20">

                <Label Text="Login to Your Account"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#007B83"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

                <VerticalStackLayout Spacing="5">
                    <Label Text="Student ID" TextColor="Black" FontSize="16" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 25" Stroke="Gray" Padding="15,0">
                        <Entry x:Name="StudentIDEntry"
                           Placeholder="e.g, 22-0000000" 
                           PlaceholderColor="LightGray"
                           TextColor="Black"
                           MaxLength="10"
                           HeightRequest="50" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Password" TextColor="Black" FontSize="16" FontAttributes="Bold" />
                    <Border StrokeShape="RoundRectangle 25" Stroke="Gray" Padding="15,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry x:Name="PasswordEntry"
                               Grid.Column="0" 
                               Placeholder="Please enter your password" 
                               IsPassword="True"
                               PlaceholderColor="LightGray"
                               TextColor="Black"
                               HeightRequest="50" />

                            <ImageButton Grid.Column="1" 
                                     Source="eyehide.png" 
                                     HeightRequest="1" 
                                         WidthRequest="1"
                                     BackgroundColor="Transparent"
                                     Clicked="OnTogglePasswordClicked"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="Auto, *">
                    <HorizontalStackLayout Grid.Column="0" Spacing="5" VerticalOptions="Center">
                        <CheckBox x:Name="RememberMeCheckBox" Color="#007B83" />
                        <Label Text="Remember me" VerticalOptions="Center" TextColor="#007B83" FontSize="14" />
                    </HorizontalStackLayout>

                    <Label Grid.Column="1" 
                       Text="Forgot password?" 
                       TextColor="#007B83" 
                       FontAttributes="Bold"
                       HorizontalOptions="End" 
                       VerticalOptions="Center" 
                       FontSize="14" />
                </Grid>

                <Button Text="Login"
                    BackgroundColor="#007B83"
                    TextColor="White"
                    CornerRadius="25"
                    HeightRequest="50"
                    FontSize="18"
                    Margin="0,20,0,10"
                    Clicked="OnLoginClicked"/>

                <BoxView HeightRequest="1" Color="#007B83" HorizontalOptions="Fill" Margin="0,10" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="Don't have an account?" TextColor="Black" FontSize="14" />
                    <Label Text="Sign up" TextColor="Black" FontAttributes="Bold" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSignUpTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <BoxView Grid.Row="2" InputTransparent="True">
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="White" Offset="0.1" />
                    <GradientStop Color="#63A1A6" Offset="1.0" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>
    </Grid>

</ContentPage>
