<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SPMobile.Views.NotificationsPage"
             x:Name="thisPage"
             Title="Notifications"
             BackgroundColor="#F5F5F5"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- HEADER -->
        <Border BackgroundColor="#008080" Padding="20">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>

            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Offset="0,2" Radius="6"/>
            </Border.Shadow>

            <Label Text="Academic Alerts"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
        </Border>

        <!-- NOTIFICATIONS LIST -->
        <CollectionView x:Name="cvNotifications" Grid.Row="1" Margin="15">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Margin="0,5"
                            Padding="15"
                            Stroke="#E0E0E0"
                            StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>

                        <HorizontalStackLayout Spacing="15">

                            <!-- LEFT COLOR BAR -->
                            <BoxView WidthRequest="5"
                                     BackgroundColor="{Binding AlertColor}"
                                     VerticalOptions="Fill"
                                     CornerRadius="2"/>

                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">

                                <Label Text="{Binding Title}"
                                       FontAttributes="Bold"
                                       FontSize="16"
                                       TextColor="#333333"/>

                                <Label Text="{Binding Message}"
                                       FontSize="13"
                                       TextColor="#555555"
                                       LineBreakMode="WordWrap"/>

                                <Label Text="{Binding Date}"
                                       FontSize="11"
                                       TextColor="Gray"
                                       Margin="0,5,0,0"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

            <!-- EMPTY VIEW -->
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Margin="0,100,0,0">

                    <Label Text="{Binding EmptyStateText, Source={x:Reference thisPage}}"
                           TextColor="Gray"
                           FontSize="16"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

        </CollectionView>

    </Grid>
</ContentPage>